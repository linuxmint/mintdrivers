#: usr/lib/linuxmint/mintdrivers/mintdrivers.py:67 generate_desktop_files:26
#: generate_desktop_files:41 usr/share/linuxmint/mintdrivers/main.ui.h:12
msgid "Driver Manager"
msgstr "Драйвер менеджері"

#: usr/lib/linuxmint/mintdrivers/mintdrivers.py:71
msgid "Re_vert"
msgstr "Кері қай_тару"

#: usr/lib/linuxmint/mintdrivers/mintdrivers.py:73
msgid "_Apply Changes"
msgstr "Өзгерістерді іске асы_ру"

#: usr/lib/linuxmint/mintdrivers/mintdrivers.py:75
msgid "_Cancel"
msgstr "Бас тар_ту"

#: usr/lib/linuxmint/mintdrivers/mintdrivers.py:77
msgid "_Restart..."
msgstr "Қайта іске қо_су..."

#: usr/lib/linuxmint/mintdrivers/mintdrivers.py:211
msgid "Downloading drivers..."
msgstr "Драйверлер жүктелуде..."

#: usr/lib/linuxmint/mintdrivers/mintdrivers.py:213
msgid "Installing drivers..."
msgstr "Драйверлер орнатылуда..."

#: usr/lib/linuxmint/mintdrivers/mintdrivers.py:215
msgid "Removing drivers..."
msgstr "Драйверлер өшірілуде..."

#: usr/lib/linuxmint/mintdrivers/mintdrivers.py:217
msgid "Cancelling..."
msgstr "Бас тартылуда..."

#: usr/lib/linuxmint/mintdrivers/mintdrivers.py:219
msgid "Loading cache..."
msgstr "Кэш жүктелуде..."

#: usr/lib/linuxmint/mintdrivers/mintdrivers.py:423
msgid "This device is using the recommended driver."
msgstr "Бұл құрылғы ұсынылған драйверді қолдануда."

#: usr/lib/linuxmint/mintdrivers/mintdrivers.py:424
msgid "This device is using an alternative driver."
msgstr "Бұл құрылғы балама драйверді қолдануда."

#: usr/lib/linuxmint/mintdrivers/mintdrivers.py:425
msgid "This device is using a manually-installed driver."
msgstr "Бұл құрылғы қолмен орнатылған драйверді қолдануда."

#: usr/lib/linuxmint/mintdrivers/mintdrivers.py:426
msgid "This device is not working."
msgstr "Бұл құрылғы жұмыс істемейді."

#: usr/lib/linuxmint/mintdrivers/mintdrivers.py:435
msgid "Continue using a manually installed driver"
msgstr "Қолмен орнатылған драйверді пайдалануды жалғастыру"

#: usr/lib/linuxmint/mintdrivers/mintdrivers.py:468
msgid "Version"
msgstr "Нұсқасы"

#: usr/lib/linuxmint/mintdrivers/mintdrivers.py:471
msgid "recommended"
msgstr "ұсынылған"

#: usr/lib/linuxmint/mintdrivers/mintdrivers.py:473
msgid "open-source"
msgstr "ашық бастапқы кодты"

#: usr/lib/linuxmint/mintdrivers/mintdrivers.py:476
msgid "requires a connection to the Internet"
msgstr "Интернетке қосылуды қажет етеді"

#: usr/lib/linuxmint/mintdrivers/mintdrivers.py:500
msgid "Do not use the device"
msgstr "Құрылғыны пайдаланбау"

#: usr/lib/linuxmint/mintdrivers/mintdrivers.py:518
#: usr/lib/linuxmint/mintdrivers/mintdrivers.py:519
#: usr/lib/linuxmint/mintdrivers/mintdrivers.py:598
msgid "Unknown"
msgstr "Белгісіз"

#: usr/lib/linuxmint/mintdrivers/mintdrivers.py:542
msgid "Processor"
msgstr "Процессор"

#: usr/lib/linuxmint/mintdrivers/mintdrivers.py:580
msgid "Processor microcode"
msgstr "Процессор микрокоды"

#: usr/lib/linuxmint/mintdrivers/mintdrivers.py:642
msgid "Do not update the CPU microcode"
msgstr "CPU микрокодын жаңартпау"

#: usr/lib/linuxmint/mintdrivers/mintdrivers.py:683
msgid "You need to restart the computer to complete the driver changes."
msgstr "Драйвер өзгерістерін аяқтау үшін компьютерді қайта іске қосу қажет."

#: usr/lib/linuxmint/mintdrivers/mintdrivers.py:697
#, python-format
msgid "%(count)d proprietary driver in use."
msgid_plural "%(count)d proprietary drivers in use."
msgstr[0] "%(count)d меншікті драйвер пайдаланылуда."
msgstr[1] "%(count)d меншікті драйвер пайдаланылуда."

#: usr/lib/linuxmint/mintdrivers/mintdrivers.py:702
msgid "No proprietary drivers are in use."
msgstr "Меншікті драйверлер пайдаланылмайды."

#: generate_desktop_files:26 generate_desktop_files:41
#: usr/share/linuxmint/mintdrivers/main.ui.h:13
msgid "Additional and proprietary drivers"
msgstr "Қосымша және меншікті драйверлер"

#: generate_desktop_files:41
msgid "Manage the drivers for your devices"
msgstr "Құрылғыларыңыздың драйверлерін басқару"

#: generate_desktop_files:67 usr/share/linuxmint/mintdrivers/main.ui.h:11
msgid "Mount installation media"
msgstr "Орнату медиасын орнату"

#: usr/share/linuxmint/mintdrivers/main.ui.h:1
msgid "Looking for drivers"
msgstr "Драйверлер ізделуде"

#: usr/share/linuxmint/mintdrivers/main.ui.h:2
msgid "Please wait..."
msgstr "Күте тұрыңыз..."

#: usr/share/linuxmint/mintdrivers/main.ui.h:3
msgid "No drivers needed"
msgstr "Драйверлер қажет емес"

#: usr/share/linuxmint/mintdrivers/main.ui.h:4
msgid "Your computer does not need any additional drivers."
msgstr "Компьютеріңізге қосымша драйверлер қажет емес."

#: usr/share/linuxmint/mintdrivers/main.ui.h:5
msgid "An error occurred"
msgstr "Қате орын алды"

#: usr/share/linuxmint/mintdrivers/main.ui.h:6
msgid "OK"
msgstr "OK"

#: usr/share/linuxmint/mintdrivers/main.ui.h:7
msgid "You appear to be offline"
msgstr "Сіз желіден тыссыз сияқтысыз"

#: usr/share/linuxmint/mintdrivers/main.ui.h:8
msgid ""
"Connect to the Internet or insert the Linux Mint installation disc (or USB "
"stick)."
msgstr ""
"Интернетке қосылыңыз немесе Linux Mint орнату дискісін (немесе USB "
"флешкасын) салыңыз."

#: usr/share/linuxmint/mintdrivers/main.ui.h:9
msgid "Installation media detected"
msgstr "Орнату медиасы анықталды"

#: usr/share/linuxmint/mintdrivers/main.ui.h:10
msgid "Press the button below to mount it as a software repository."
msgstr ""
"Оны бағдарламалық қамтама қоймасы ретінде орнату үшін төмендегі батырманы "
"басыңыз."
